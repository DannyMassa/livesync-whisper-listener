{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config", "secrets"],
  "properties": {
    "config": {
      "type": "object",
      "required": ["couchdbUrl", "couchdbUsername", "database", "whisperUrl"],
      "properties": {
        "couchdbUrl": { "type": "string", "pattern": "^https?://.+" },
        "couchdbUsername": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "whisperUrl": { "type": "string", "pattern": "^https?://.+" },
        "whisperTimeoutMs": { "type": "integer", "minimum": 1 },
        "maxAudioBytes": { "type": "integer", "minimum": 1 },
        "intervalSeconds": { "type": "integer", "minimum": 1 },
        "redactPaths": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "couchdbPasswordKey": { "type": "string", "minLength": 1 },
        "e2eePassphraseKey": { "type": "string", "minLength": 1 }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
